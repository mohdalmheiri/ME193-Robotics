<mujoco model="silly_walker">
  <compiler angle="radian" meshdir="../cad/assets"/>

  <option timestep="0.0005" integrator="implicitfast"/>

  <statistic extent="0.25" center="0 -0.02 0.02"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <default class="silly_walker">
      <joint armature="0.005" frictionloss="0.1"/>
      <general input="pos" biastype="affine" gainprm="50" biasprm="0 -50 1"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
    </default>
  </default>

  <asset>
    <texture type="2d" colorspace="auto" name="grid" builtin="checker" mark="edge" rgb1="0.82 0.72 0.58" rgb2="0.72 0.62 0.48" markrgb="0.4 0.35 0.3" width="300" height="300"/>
    <material name="body_material" rgba="0.615686 0.811765 0.929412 1"/>
    <material name="leg_right_material" rgba="0.647059 0.647059 0.647059 1"/>
    <material name="leg_left_material" rgba="0.647059 0.647059 0.647059 1"/>
    <material name="table" texture="grid" texrepeat="10 10" texuniform="true"/>
    <mesh name="leg_right" content_type="model/stl" file="leg_right.stl"/>
    <mesh name="leg_left" content_type="model/stl" file="leg_left.stl"/>
    <mesh name="body" content_type="model/stl" file="body.stl"/>
  </asset>

  <worldbody>
    <geom name="table" size="0 0 0.05" type="plane" friction="0.6" solref="0.002" material="table"/>
    <light pos="0 0 1.5" type="directional"/>
    <body name="body" childclass="silly_walker" pos="0 0 0.017">
      <inertial pos="0 -0.0234044 0" quat="0.5 0.5 -0.5 0.5" mass="0.100006" diaginertia="7.69302e-05 6.11874e-05 3.02849e-05"/>
      <joint name="free" class="main" type="free"/>
      <geom class="visual" quat="1 0 0 0" material="body_material" mesh="body"/>
      <geom name="body_box" size="0.024 0.04 0.015" pos="0 -0.025 0" type="box" group="3" friction="0.6" solref="0.002" rgba="1 0.4 0.1 0.5"/>
      <geom name="hub_right" size="0.0125 0.004" pos="0.028 0 0" quat="0.707107 0 0.707107 0" type="cylinder" group="3" friction="0.6" solref="0.002" rgba="1 0.4 0.1 0.5"/>
      <geom name="hub_left" size="0.0125 0.004" pos="-0.028 0 0" quat="0.707107 0 0.707107 0" type="cylinder" group="3" friction="0.6" solref="0.002" rgba="1 0.4 0.1 0.5"/>
      <body name="leg_right" pos="0.0398 0 0" quat="0.5 0.5 0.5 0.5">
        <inertial pos="0.0164855 0 -0.0039" quat="0 0.707107 0 0.707107" mass="0.00284977" diaginertia="1.00173e-06 9.93755e-07 3.6874e-08"/>
        <joint name="right" armature="1e-05" frictionloss="0.002"/>
        <geom class="visual" pos="0 0 -0.0398" quat="0.5 -0.5 -0.5 -0.5" material="leg_right_material" mesh="leg_right"/>
        <geom name="leg_right_box" size="0.032 0.0048 0.0039" pos="0.016 0 -0.0039" type="box" group="3" friction="0.6" solref="0.002" rgba="1 0.4 0.1 0.5"/>
      </body>
      <body name="leg_left" pos="-0.032 0 0" quat="0.5 0.5 0.5 0.5">
        <inertial pos="0.0164855 0 -0.0039" quat="0 0.707107 0 0.707107" mass="0.00284977" diaginertia="1.00173e-06 9.93755e-07 3.6874e-08"/>
        <joint name="left" armature="1e-05" frictionloss="0.002"/>
        <geom class="visual" pos="0 0 0.032" quat="0.5 -0.5 -0.5 -0.5" material="leg_left_material" mesh="leg_left"/>
        <geom name="leg_left_box" size="0.032 0.0048 0.0039" pos="0.016 0 -0.0039" type="box" group="3" friction="0.6" solref="0.002" rgba="1 0.4 0.1 0.5"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="motor_right" joint="right" forcelimited="true" forcerange="-0.1 0.1" input="vel" biastype="affine" gainprm="0.05" biasprm="0 0 -0.05"/>
    <general name="motor_left" joint="left" forcelimited="true" forcerange="-0.1 0.1" input="vel" biastype="affine" gainprm="0.05" biasprm="0 0 -0.05"/>
  </actuator>
</mujoco>
